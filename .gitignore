# ═══════════════════════════════════════════════════════════
# 环境配置 —— 含数据库密码 / Redis 密码 / AWS 密钥 / 后台管理员密码
# 这类文件一旦进过 git 历史就收不回来，即使仓库转公开或加协作者
# ═══════════════════════════════════════════════════════════
.env
.env.prod
.env.local
.env.*.bak-*
.env.prod.bak-*
.env.*.bak

# 只放行示例模板（不含真实值）
!.env.example
!.env.prod.example
!.env.ui-v3.example

# ═══════════════════════════════════════════════════════════
# 证书与私钥
# ═══════════════════════════════════════════════════════════
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# ═══════════════════════════════════════════════════════════
# Laravel 运行时数据（日志含请求参数，可能带敏感信息）
# ═══════════════════════════════════════════════════════════
src/storage/logs/*
src/storage/framework/cache/data/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/storage/framework/testing/*
src/storage/app/private/*
src/storage/app/backups/*
src/bootstrap/cache/*.php

# 保留目录结构
!src/storage/**/.gitkeep
!src/bootstrap/cache/.gitignore

# ═══════════════════════════════════════════════════════════
# 第三方依赖（clone 后自行 composer install / npm install）
# ═══════════════════════════════════════════════════════════
node_modules/
src/node_modules/
src/public/vendor/
src/vendor/

# ═══════════════════════════════════════════════════════════
# 日志与备份
# ═══════════════════════════════════════════════════════════
*.log
backup/
backup-*/
*.bak
*.bak-*
*.sql.gz
*.dump

# 但保留数据库结构备份脚本说明
!backup/.gitkeep

# ═══════════════════════════════════════════════════════════
# 测试与调试产物
# ═══════════════════════════════════════════════════════════
.qa-probes/
_tmp_*
*.pid
*.seed

# ═══════════════════════════════════════════════════════════
# 编辑器 / 系统文件
# ═══════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ═══════════════════════════════════════════════════════════
# Docker 本地覆盖（含本机绝对路径，换机器跑不通）
# ═══════════════════════════════════════════════════════════
# 注意：docker-compose.local-override.yml 里是我们所有补丁的挂载声明，
# 是这份仓库的核心内容之一，**必须提交**，不要加进这里。
